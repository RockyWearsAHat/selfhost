# Rust build output
/target/
**/*.rs.bk

# Persistent state: databases, mail spools, TLS keys and certificates, backups.
# Deleting this loses the deployment — it is what the backups are for.
data/

# Generated artifacts, rebuilt by `selfhost render`.
runtime/

# Secrets. Only .env.example is tracked.
.env
.env.*
!.env.example
secrets/

# The live config carries hostnames and mailbox addresses.
selfhost.config.toml

# Site content served by the proxy — the user's websites, not this project's
# source. The one exception: sites/console is the web admin console's own SPA,
# shipped with the project, so it stays tracked.
sites/*
!sites/console/

# OS noise
.DS_Store

# Tool caches: the dx document index and the Helpers project index. Both are
# rebuilt from the tree they describe, so committing them only stores staleness.
.doc/
.helpers/

# Scratch directory for the service-manager demo (see .demo/svc)
.demo/

# local agent/security notes — never commit
CLAUDE.md

# local security tooling & docs — do not commit
scripts/verify-hardening.zsh
scripts/lockdown.sh
scripts/verify-security.sh
docs/SECURITY.md
